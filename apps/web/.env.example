# apps/web environment surface.
#
# Copy to `.env.local` for local development (`.env.local` is gitignored).
# Deployed values are set in the Vercel project by the operator, never by an agent:
# see docs/2.0/DEPLOY-2.0.md. `src/lib/env.ts` is the only reader in the app.
#
# Rule that never bends: NEXT_PUBLIC_* is compiled into the client bundle and is
# public. Nothing secret ever carries that prefix.

# ---------------------------------------------------------------------------
# Public. Inlined into the client bundle at build time; changing one needs a rebuild.
# ---------------------------------------------------------------------------

# Gateway REST base, e.g. https://api.example/ - reserved now, first read in HANDOFF-05/11.
NEXT_PUBLIC_API_URL=

# Gateway WebSocket, e.g. wss://<tunnel>/stream - reserved now, first read in HANDOFF-11.
NEXT_PUBLIC_WS_URL=

# Published snapshot document URL - reserved now, first read in HANDOFF-09.
NEXT_PUBLIC_SNAPSHOT_URL=

# fixture | snapshot | live. Where the page gets its numbers. Unset falls back to fixture.
NEXT_PUBLIC_DATA_MODE=fixture

# Set to 1 ONLY to expose /dev/primitives and the window.__zr instrumentation in a production
# build. Playwright sets it for the assertion run; nothing else ever should, and it is never set
# on Vercel. Absent means the dev surfaces do not exist, which is the correct default everywhere
# except that one test run - the gate fails closed on purpose. See src/lib/env.ts.
# NEXT_PUBLIC_ENABLE_DEV_SURFACES=

# ---------------------------------------------------------------------------
# SERVER-ONLY. Never given a NEXT_PUBLIC_ prefix, never logged, never sent to the client.
# Nothing in apps/web reads any of these until HANDOFF-11; they are listed so the names are
# reserved and so no one invents a public alias. Left commented out on purpose - a local dev
# run needs none of them. Real values live in the Vercel project settings and in the operator's
# password manager, never in this file and never in git.
# ---------------------------------------------------------------------------

# THESE NAMES ARE THE INTEGRATION'S, NOT OURS. The Upstash store is connected to the zecreveal
# project with the custom variable prefix SNAPSHOT_REDIS, and Vercel injects the five names below
# into Production and Preview automatically. They are listed here so a local run can see what the
# deployed environment holds, not because anyone sets them by hand. An earlier version of this
# file listed SNAPSHOT_REDIS_REST_URL / SNAPSHOT_REDIS_REST_TOKEN / SNAPSHOT_REDIS_URL, which are
# injected by nothing - corrected in HANDOFF-05. See docs/2.0/SNAPSHOT.md section 3.

# Vercel-managed Redis, REST endpoint. Holds only zecreveal:snapshot:* keys.
# Read server-side by apps/web (RSC and route handlers) from HANDOFF-11.
# SNAPSHOT_REDIS_KV_REST_API_URL=

# READ-ONLY bearer token for the REST endpoint above. This is the one apps/web uses.
# SNAPSHOT_REDIS_KV_REST_API_READ_ONLY_TOKEN=

# The read-write token. apps/web must NEVER use it: the publisher is the only writer, and it does
# not run on Vercel. Injected, listed here so nobody reaches for it by mistake.
# SNAPSHOT_REDIS_KV_REST_API_TOKEN=

# The TCP connection used by apps/publisher on the VPS to write the snapshot. Upstash injects both
# spellings; either works. apps/web never reads them.
# SNAPSHOT_REDIS_KV_URL=
# SNAPSHOT_REDIS_REDIS_URL=

# THE MANAGED STORE IS SHARED with an unrelated production project. Every key begins zecreveal:,
# the destructive and enumerating commands are forbidden outright, and nothing here may point a
# test or a local run at it. docs/2.0/SNAPSHOT.md carries the rules; CI enforces the command list.

# Note on the other Redis: the VPS REDIS_URL (pub/sub, zcashreveal:mempool:live, the anchor
# registry) is the hot path, never leaves the box, and has no entry in this file at all.
# It is documented in the repo-root .env.example.
