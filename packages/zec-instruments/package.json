{
  "name": "@zcashreveal/instruments",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@zcashreveal/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "fast-check": "^4.8.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.6"
  }
}
