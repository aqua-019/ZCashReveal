{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "composite": true,
    "types": [
      "node"
    ],
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo"
  },
  "//": "data/**/*.json is spelled out: a bare **/* glob only picks up TypeScript.",
  "include": [
    "src/**/*.ts",
    "data/**/*.json",
    "scripts/**/*.ts",
    "test/**/*.ts"
  ]
}
