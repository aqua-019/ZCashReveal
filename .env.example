# zebrad RPC
# The node's JSON-RPC endpoint.
# On the VPS the indexer is a CONTAINER and reaches http://zebrad:8232 over the
# compose network; docker-compose.yml publishes NO host port for the RPC, which
# is what makes enable_cookie_auth=false safe. This value is for a HOST-run
# process against the dev override, which republishes 8232 on loopback.
ZEBRAD_RPC_URL=http://127.0.0.1:8232
# Basic-auth credentials. Kept for zcashd and for an auth-enabled Zebra; the dev-mode Zebra runs enable_cookie_auth=false and ignores them.
ZEBRAD_RPC_USER=zcashreveal
ZEBRAD_RPC_PASSWORD=changeme
# ZMQ endpoint the indexer subscribes to.
# INERT AGAINST ZEBRA, which has no ZMQ server: zebrad exposes no such socket at
# any version (ZMQ was zcashd's). The indexer logs "zmq unavailable - falling
# back to polling only" once at boot and then polls INDEXER_POLL_INTERVAL_MS
# forever. Kept because apps/indexer still constructs a subscriber from it. See
# infra/zebrad/zebrad.toml under [notify] for Zebra's equivalent, and
# docs/2.0/RUNBOOK-VPS.md section 3.
# ON THE VPS, CHANGE THIS TO tcp://zebrad:28332 BY HAND. An earlier draft said
# the compose file "overrides" it, which is false: docker-compose.yml writes
# ${ZEBRAD_ZMQ_URL:-tcp://zebrad:28332}, and a `:-` default yields the .env value
# whenever one is set - and section 1 of the runbook begins `cp .env.example .env`,
# so one always is. Behaviourally inert either way, since nothing is listening,
# but a false statement about the stack in the file the operator copies is worth
# one line to correct.
ZEBRAD_ZMQ_URL=tcp://127.0.0.1:28332
# Per-attempt RPC timeout in milliseconds, and how many TRANSPORT failures to retry. A JSON-RPC error is never retried.
ZEBRAD_RPC_TIMEOUT_MS=10000
ZEBRAD_RPC_RETRIES=2

# Persistence
# 5433 is the HOST port both compose files publish; the container port stays
# 5432, so a service INSIDE the stack uses postgres:5432 and only a host-run
# process (pnpm dev, pnpm migrate, the integration suites) uses 5433.
DATABASE_URL=postgres://zcashreveal:CHANGEME@localhost:5433/zcashreveal
REDIS_URL=redis://localhost:6379

# Indexer
INDEXER_POLL_INTERVAL_MS=2000
INDEXER_LOG_LEVEL=info

# Gateway
# Bind address and port for the Fastify server.
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
# Comma-separated CORS allow list, or * for a fully public read API.
GATEWAY_CORS_ORIGIN=http://localhost:5173
# Log level: fatal | error | warn | info | debug | trace | silent.
GATEWAY_LOG_LEVEL=info
# Which chain this gateway reads. Decides which transparent address prefixes are accepted, so a mainnet gateway refuses a testnet address with a stated reason.
GATEWAY_NETWORK=mainnet
# Per-IP request budget and its window in milliseconds. Over it: 429 with retry-after.
GATEWAY_RATE_LIMIT_MAX=100
GATEWAY_RATE_LIMIT_WINDOW_MS=10000
# Optional shared store for the rate limiter. UNSET is the default and means an in-process store and exactly two Redis connections; setting it opens a third, which is right only when several gateway processes share one budget.
# RATE_LIMIT_REDIS_URL=redis://localhost:6379
# WebSocket connection cap. The connection that would exceed it is closed with code 1013, Try Again Later.
GATEWAY_WS_MAX_CONNECTIONS=500
# Addresses whose x-forwarded-for this gateway believes, comma-separated. EMPTY IS THE DEFAULT AND IS THE SAFE ONE: the rate limiter keys on req.ip, so behind a reverse proxy with this empty every reader shares one bucket, and with blanket trust any caller could forge the header and escape the limit entirely. Set it to the tunnel's address when deploying behind cloudflared (HANDOFF-10).
GATEWAY_TRUSTED_PROXIES=
# Cache-aside TTLs in seconds for the address and transaction caches. Zero disables the cache entirely.
GATEWAY_ADDRESS_CACHE_TTL_S=60
GATEWAY_TX_CACHE_TTL_S=3600
# How many of an address's transactions the address view reads in full. The rest are counted and the view says so.
GATEWAY_ADDRESS_TX_LIMIT=50
# How many funding transactions a fee computation may fetch before refusing with a 413 that names the bound. No node reports a fee, so a fee costs one lookup per distinct funding transaction.
GATEWAY_MAX_FUNDING_LOOKUPS=256

# Publisher
# Where the file sink writes the snapshot. THE GATEWAY READS THE SAME PATH under the same
# variable name, so a host-run pair must agree on it; in the compose stack docker-compose.yml
# sets it to /var/lib/zecreveal/snapshot.json on a named volume and ignores this value.
SNAPSHOT_FILE=./snapshot.json
# The monthly managed-store command counter, keyed YYYY-MM, read at startup and flushed after each
# tip. A FILE, never the store it counts and never memory alone: in the store it would be a fourth
# command per tip, and in memory it would reset on restart and make the ceiling below vacuous.
SNAPSHOT_BUDGET_FILE=./snapshot-budget.json
# Log level: fatal | error | warn | info | debug | trace | silent.
PUBLISHER_LOG_LEVEL=info
# The drain's denominator height - mainnet NU6.3, where Orchard became exit-only. A publisher
# pointed at testnet, or a chart re-based to a later height, sets its own.
SNAPSHOT_DRAIN_BASELINE_HEIGHT=3428143
# How many blocks back the migration lens looks from the tip. 1152 is one day at the 75-second
# target interval; a histogram over all of history answers a different question from a live one.
SNAPSHOT_MIGRATION_WINDOW_BLOCKS=1152

# Vercel-managed Redis - the SNAPSHOT store, and NOT the REDIS_URL above
#
# TWO SERVERS, NEVER CONFUSED. REDIS_URL at the top of this file is the VPS Redis: pub/sub,
# zcashreveal:mempool:live, the anchor registry, hot path, never leaves the box. The variables
# below address a Vercel-managed Upstash store that holds zecreveal:snapshot:* and nothing else.
#
# THAT STORE IS SHARED with an unrelated production project, deliberately, on the free tier. A
# mistake against it is an outage for someone who never agreed to run alongside us. Every key
# begins zecreveal:; FLUSHDB, FLUSHALL, SWAPDB and SCRIPT FLUSH are forbidden everywhere; KEYS is
# forbidden outright and SCAN only with MATCH zecreveal:*; no DEL by pattern; and no test or local
# run ever points at it. docs/2.0/SNAPSHOT.md carries the rules and CI enforces the command list.
#
# The names are the ones Vercel's integration injects under the custom prefix SNAPSHOT_REDIS, not
# names this repository chose. On the VPS the operator writes the TCP URL by hand, under the same
# spelling so that a value copied out of the Vercel UI lands under the name it came with.
# Commented out: the publisher (HANDOFF-09) is the only process that needs them, and its real
# values live in the VPS .env, never in git.

# Either TCP spelling; Upstash injects both. apps/publisher writes the snapshot over this.
# THE URL'S USERINFO IS THE STORE'S PASSWORD, so the real one is pasted into the VPS .env by hand
# and never reaches git; the line below is the SHAPE, with a token that is obviously not one. It is
# also the only rediss:// string this repository commits, which is what A8's grep is written to see.
# SNAPSHOT_REDIS_KV_URL=rediss://default:PLACEHOLDER-NOT-A-REAL-TOKEN@example-store.upstash.io:6379
# SNAPSHOT_REDIS_REDIS_URL=
# REST endpoint and its READ-ONLY token - apps/web reads server-side. Set on Vercel, not here.
# SNAPSHOT_REDIS_KV_REST_API_URL=
# SNAPSHOT_REDIS_KV_REST_API_READ_ONLY_TOKEN=
# Monthly command ceiling for the publisher. The allowance is 500000 SHARED with the other
# project; the publisher refuses to start rather than let this project be the one that exhausts it.
# SNAPSHOT_REDIS_MONTHLY_BUDGET=150000

# Compose stack (HANDOFF-10) - docker-compose.yml reads these
#
# THREE OF THESE ARE REQUIRED AND HAVE NO DEFAULT. POSTGRES_PASSWORD,
# GATEWAY_CORS_ORIGIN and TUNNEL_TOKEN are written ${VAR:?...} in
# docker-compose.yml, so ANY compose command - including `config` and a
# single-service `up` - fails with the message beside them until all three are
# set. Compose interpolates the whole file before it decides what to start, so
# this is not per-service. RUNBOOK-VPS.md section 1 sets all three before the
# first compose command for exactly that reason.
#
# GATEWAY_TRUSTED_PROXIES is deliberately NOT in that group any more: it needs a
# value that can only be read once the tunnel container exists, and making it
# required made the runbook circular. It defaults to the private ranges Docker
# allocates compose networks from, which is correct for this topology, and
# section 6.1 narrows it to the exact address.

# Postgres. The container port stays 5432 and the compose network addresses it
# as `postgres:5432`; only the operator's psql uses the published 127.0.0.1:5433.
POSTGRES_USER=zcashreveal
# REQUIRED, no default. Generate one: openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=zcashreveal

# The Cloudflare tunnel's credentials, as one token. REQUIRED, no default, and
# needed BEFORE the first compose command because compose interpolates the whole
# file. `cloudflared tunnel token <name>` prints it; RUNBOOK-VPS.md section 2
# creates the tunnel first for that reason. A secret; never belongs in git.
TUNNEL_TOKEN=

# Whose x-forwarded-for the gateway believes. The rate limiter keys on req.ip, so
# behind the tunnel an empty value puts every reader in one bucket and blanket
# trust lets any caller forge the header. The default below is the RFC 1918 range
# Docker allocates compose networks from, which covers the tunnel container and
# nothing off the box; RUNBOOK-VPS.md section 6.1 narrows it to the exact address
# once the network exists.
GATEWAY_TRUSTED_PROXIES=172.16.0.0/12
