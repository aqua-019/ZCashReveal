# zebrad RPC
# The node's JSON-RPC endpoint. Loopback-bound in docker-compose.yml.
ZEBRAD_RPC_URL=http://127.0.0.1:8232
# Basic-auth credentials. Kept for zcashd and for an auth-enabled Zebra; the dev-mode Zebra runs enable_cookie_auth=false and ignores them.
ZEBRAD_RPC_USER=zcashreveal
ZEBRAD_RPC_PASSWORD=changeme
# ZMQ endpoint the indexer subscribes to for mempool and block notifications.
ZEBRAD_ZMQ_URL=tcp://127.0.0.1:28332
# Per-attempt RPC timeout in milliseconds, and how many TRANSPORT failures to retry. A JSON-RPC error is never retried.
ZEBRAD_RPC_TIMEOUT_MS=10000
ZEBRAD_RPC_RETRIES=2

# Persistence
DATABASE_URL=postgres://zcashreveal:zcashreveal@localhost:5432/zcashreveal
REDIS_URL=redis://localhost:6379

# Indexer
INDEXER_POLL_INTERVAL_MS=2000
INDEXER_LOG_LEVEL=info

# Gateway
# Bind address and port for the Fastify server.
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
# Comma-separated CORS allow list, or * for a fully public read API.
GATEWAY_CORS_ORIGIN=http://localhost:5173
# Log level: fatal | error | warn | info | debug | trace | silent.
GATEWAY_LOG_LEVEL=info
# Which chain this gateway reads. Decides which transparent address prefixes are accepted, so a mainnet gateway refuses a testnet address with a stated reason.
GATEWAY_NETWORK=mainnet
# Per-IP request budget and its window in milliseconds. Over it: 429 with retry-after.
GATEWAY_RATE_LIMIT_MAX=100
GATEWAY_RATE_LIMIT_WINDOW_MS=10000
# Optional shared store for the rate limiter. UNSET is the default and means an in-process store and exactly two Redis connections; setting it opens a third, which is right only when several gateway processes share one budget.
# RATE_LIMIT_REDIS_URL=redis://localhost:6379
# WebSocket connection cap. The connection that would exceed it is closed with code 1013, Try Again Later.
GATEWAY_WS_MAX_CONNECTIONS=500
# Addresses whose x-forwarded-for this gateway believes, comma-separated. EMPTY IS THE DEFAULT AND IS THE SAFE ONE: the rate limiter keys on req.ip, so behind a reverse proxy with this empty every reader shares one bucket, and with blanket trust any caller could forge the header and escape the limit entirely. Set it to the tunnel's address when deploying behind cloudflared (HANDOFF-10).
GATEWAY_TRUSTED_PROXIES=
# Cache-aside TTLs in seconds for the address and transaction caches. Zero disables the cache entirely.
GATEWAY_ADDRESS_CACHE_TTL_S=60
GATEWAY_TX_CACHE_TTL_S=3600
# How many of an address's transactions the address view reads in full. The rest are counted and the view says so.
GATEWAY_ADDRESS_TX_LIMIT=50
# How many funding transactions a fee computation may fetch before refusing with a 413 that names the bound. No node reports a fee, so a fee costs one lookup per distinct funding transaction.
GATEWAY_MAX_FUNDING_LOOKUPS=256

# Vercel-managed Redis - the SNAPSHOT store, and NOT the REDIS_URL above
#
# TWO SERVERS, NEVER CONFUSED. REDIS_URL at the top of this file is the VPS Redis: pub/sub,
# zcashreveal:mempool:live, the anchor registry, hot path, never leaves the box. The variables
# below address a Vercel-managed Upstash store that holds zecreveal:snapshot:* and nothing else.
#
# THAT STORE IS SHARED with an unrelated production project, deliberately, on the free tier. A
# mistake against it is an outage for someone who never agreed to run alongside us. Every key
# begins zecreveal:; FLUSHDB, FLUSHALL, SWAPDB and SCRIPT FLUSH are forbidden everywhere; KEYS is
# forbidden outright and SCAN only with MATCH zecreveal:*; no DEL by pattern; and no test or local
# run ever points at it. docs/2.0/SNAPSHOT.md carries the rules and CI enforces the command list.
#
# The names are the ones Vercel's integration injects under the custom prefix SNAPSHOT_REDIS, not
# names this repository chose. On the VPS the operator writes the TCP URL by hand, under the same
# spelling so that a value copied out of the Vercel UI lands under the name it came with.
# Commented out: the publisher (HANDOFF-09) is the only process that needs them, and its real
# values live in the VPS .env, never in git.

# Either TCP spelling; Upstash injects both. apps/publisher writes the snapshot over this.
# SNAPSHOT_REDIS_KV_URL=
# SNAPSHOT_REDIS_REDIS_URL=
# REST endpoint and its READ-ONLY token - apps/web reads server-side. Set on Vercel, not here.
# SNAPSHOT_REDIS_KV_REST_API_URL=
# SNAPSHOT_REDIS_KV_REST_API_READ_ONLY_TOKEN=
# Monthly command ceiling for the publisher. The allowance is 500000 SHARED with the other
# project; the publisher refuses to start rather than let this project be the one that exhausts it.
# SNAPSHOT_REDIS_MONTHLY_BUDGET=150000

# Dashboard
VITE_WS_URL=ws://localhost:8080/stream
VITE_API_URL=http://localhost:8080
VITE_MOCK_MODE=true
